{
  "name": "shortfab",
  "version": "0.1.0",
  "private": true,
  "description": "ShortFab local-first short-form editor",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run electron:dev\"",
    "electron:dev": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run check && vite build && npm run build:electron",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src electron",
    "test": "vitest run",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.1",
    "cross-env": "7.0.3",
    "electron": "38.2.2",
    "electron-builder": "26.0.12",
    "eslint": "9.34.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "6.3.6",
    "vitest": "3.2.4",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "app.shortfab.desktop",
    "productName": "ShortFab",
    "asar": true,
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "directories": {"output": "release"},
    "mac": {"target": ["dmg"], "category": "public.app-category.video"},
    "win": {"target": ["nsis"]},
    "linux": {"target": ["AppImage"]}
  }
}
